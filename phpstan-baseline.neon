parameters:
	ignoreErrors:
		# Laravel Eloquent magic methods - FALSE POSITIVE
		# whereNotNull() is a valid Eloquent query builder method
		# PHPStan doesn't recognize it because it's defined in Illuminate\Database\Query\Builder
		# and dynamically mixed into Eloquent models via __call
		-
			message: '#^Call to an undefined static method App\\Models\\Tournament\:\:whereNotNull\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: app/Console/Commands/DiagnoseStaffExtraction.php

		-
			message: '#^Call to an undefined static method App\\Models\\Tournament\:\:whereNotNull\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: app/Console/Commands/Tournaments/ReparseStaff.php

		# Laravel Eloquent query scopes - FALSE POSITIVE
		# withStaffSortedByRole() is a valid query scope defined in Tournament model
		# PHPStan doesn't recognize dynamic query scopes
		-
			message: '#^Call to an undefined static method App\\Models\\Tournament\:\:withStaffSortedByRole\(\)\.$#'
			identifier: staticMethod.notFound
			count: 1
			path: app/Http/Controllers/Admin/TournamentController.php

		-
			message: '#^Call to an undefined static method App\\Models\\Tournament\:\:withStaffSortedByRole\(\)\.$#'
			identifier: staticMethod.notFound
			count: 4
			path: tests/Unit/Models/TournamentStaffSortingTest.php

		# Laravel collect() helper type inference - FALSE POSITIVE
		# PHPStan cannot resolve generic types when collect() receives dynamic data
		# This is a known limitation of static analysis with Laravel's collection helper
		-
			message: '#^Unable to resolve the template type TKey in call to function collect$#'
			identifier: argument.templateType
			count: 1
			path: app/Jobs/BatchFetchUsersJob.php

		-
			message: '#^Unable to resolve the template type TValue in call to function collect$#'
			identifier: argument.templateType
			count: 1
			path: app/Jobs/BatchFetchUsersJob.php

		# Array return type with complex structure - ACCEPTABLE LIMITATION
		# calculateStaffDiffs returns nested arrays with dynamic keys
		# Fully typing this would require creating a DTO class, which is overkill
		-
			message: '#^Method App\\Models\\Tournament\:\:calculateStaffDiffs\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 4
			path: app/Models/Tournament.php

		# Unused private method - ACCEPTABLE
		# calculateRoleStatsFromArray is kept for potential future use
		# and for API symmetry with calculateRoleStatsFromDiffs
		-
			message: '#^Method App\\Models\\Tournament\:\:calculateRoleStatsFromArray\(\) is unused\.$#'
			identifier: method.unused
			count: 1
			path: app/Models/Tournament.php

		# Type narrowing after early return - FALSE POSITIVE
		# After checking if $dataPoints === 0, PHPStan still thinks $dataPoints could be 0
		# In reality, max($dataPoints, 1) ensures the result is at least 1
		-
			message: '#^Comparison operation "\>" between int\<1, max\> and 0 is always true\.$#'
			identifier: greater.alwaysTrue
			count: 1
			path: app/Services/OsuApiService.php

		# Database facade in migrations - FALSE POSITIVE
		# DB::statement() is a valid Laravel facade method for raw SQL
		# PHPStan doesn't recognize facades that are dynamically resolved
		-
			message: '#^Call to static method statement\(\) on an unknown class DB\.$#'
			identifier: class.notFound
			count: 4
			path: database/migrations/2026_02_03_150000_add_new_staff_roles_to_tournament_staff_table.php
