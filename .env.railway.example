# Railway Production Environment Configuration
# This file contains the environment variables needed for Railway deployment
#
# Railway Deployment Guide: docs/RAILWAY_DEPLOYMENT.md
#
# Setup Instructions:
# 1. Create PostgreSQL and Redis services in Railway dashboard
# 2. Add variables below to Railway service Variables tab
# 3. Replace placeholder values with actual values
# 4. For sensitive values, use Railway's secret management

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME="Tourney Method"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Seoul
APP_URL=https://your-app.railway.app

# =============================================================================
# Railway Build Configuration
# =============================================================================
# PHP extensions to install during build (comma-separated list)
RAILPACK_PHP_EXTENSIONS=pgsql,redis,bcmath,ctype,curl,dom,mbstring,openssl,pcntl,zip,gd

# Runtime apt packages for scheduled database backups/restores.
# Set this in each Railway app/cron service that builds from this repo.
RAILPACK_DEPLOY_APT_PACKAGES="postgresql-client-18 libpq-dev"

# =============================================================================
# Database Configuration (Railway PostgreSQL Service)
# =============================================================================
# Railway provides DATABASE_URL automatically when you create a PostgreSQL service
# Format: postgresql://postgres:password@host.railway.internal:5432/database
# We map it to DB_URL which Laravel uses

DB_CONNECTION=pgsql
DB_URL=${{Postgres.DATABASE_URL}}
# Note: Do NOT set DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# Railway handles these via DATABASE_URL

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_STORE=redis
CACHE_PREFIX=

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================================
# Queue Configuration
# =============================================================================
QUEUE_CONNECTION=redis

# =============================================================================
# Laravel Horizon Configuration
# =============================================================================
HORIZON_USER_MAX_PROCESSES=1
HORIZON_ADMIN_MAX_PROCESSES=1
HORIZON_WORKER_MEMORY=128
HORIZON_MEMORY_LIMIT=64
HORIZON_TRIM_RECENT=15
HORIZON_TRIM_PENDING=15
HORIZON_TRIM_COMPLETED=15
HORIZON_TRIM_RECENT_FAILED=1440
HORIZON_TRIM_FAILED=1440
HORIZON_TRIM_MONITORED=1440
HORIZON_METRIC_SNAPSHOTS=12

# =============================================================================
# Railway Cron Configuration
# =============================================================================
# Set one Railway Cron service per command, or pass the command as start args:
# ./railway/run-cron.sh php artisan streams:check
# ./railway/run-cron.sh php artisan reminders:registration
# ./railway/run-cron.sh php artisan notifications:eligible-tournaments
# ./railway/run-cron.sh php artisan tournaments:parse --confirm
# ./railway/run-cron.sh php artisan maintenance:weekly-essential

# =============================================================================
# Redis Configuration (Railway Redis Service)
# =============================================================================
# Railway provides REDIS_URL automatically when you create a Redis service
# Format: redis://host:port
# Laravel's Redis driver will use this automatically

REDIS_CLIENT=phpredis
# Note: Do NOT set REDIS_HOST, REDIS_PORT, REDIS_PASSWORD
# Railway handles these via REDIS_URL

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =============================================================================
# Filesystem Configuration
# =============================================================================
FILESYSTEM_DISK=s3

# =============================================================================
# Cloudflare R2 Storage (Backups)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# =============================================================================
# osu! OAuth Configuration
# =============================================================================
# Get credentials from: https://osu.ppy.sh/home/account/edit
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=https://your-app.railway.app/auth/callback

# =============================================================================
# Twitch API Configuration
# =============================================================================
# Get credentials from: https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# =============================================================================
# Third-Party API Keys
# =============================================================================
# tcomm.hivie.tn API (request from tcomm admins)
TCOMM_API_KEY=

# o!TR API (https://otr.stagec.net)
OTR_API_KEY=

# osu! Score Integration Platform (SIP)
SIP_API_KEY=

# =============================================================================
# Master User Configuration
# =============================================================================
# osu! user ID with master privileges
MASTER_OSU_ID=

# =============================================================================
# Database Backup Configuration (R2 Storage)
# =============================================================================
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=7
BACKUP_VERIFY_UPLOAD=true
BACKUP_DISCORD_WEBHOOK=

# =============================================================================
# Discord Webhooks (Optional)
# =============================================================================
DISCORD_OSU_BADGE_WEBHOOK=
DISCORD_OSU_NONBADGE_WEBHOOK=
DISCORD_TAIKO_BADGE_WEBHOOK=
DISCORD_TAIKO_NONBADGE_WEBHOOK=
DISCORD_CATCH_BADGE_WEBHOOK=
DISCORD_CATCH_NONBADGE_WEBHOOK=
DISCORD_MANIA_BADGE_WEBHOOK=
DISCORD_MANIA_NONBADGE_WEBHOOK=
