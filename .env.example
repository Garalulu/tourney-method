APP_NAME="Tourney Method"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Seoul
APP_URL=http://localhost

# Sail/Docker Configuration
WWWUSER=1000
WWWGROUP=1000
SAIL_XDEBUG_MODE=develop,debug,coverage
SAIL_SKIP_CHECKS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Docker/Sail)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=tourney_method
DB_USERNAME=sail
DB_PASSWORD=password

# Railway Configuration (Alternative to above)
# When deploying to Railway, use these URL-based variables instead:
# DATABASE_URL=postgresql://user:password@host:port/database
# DB_URL=${{Postgres.DATABASE_URL}}
# RAILPACK_PHP_EXTENSIONS=pgsql,redis,bcmath,ctype,curl,dom,mbstring,openssl,pcntl,zip,gd

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Cache Configuration
CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis Configuration (Docker/Sail)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Railway Configuration (Alternative to above)
# When deploying to Railway, Redis URL is provided automatically:
# REDIS_URL=redis://host:port

# Mail Configuration (Docker/Sail - Mailpit)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# osu! OAuth Configuration (https://osu.ppy.sh/home/account/edit)
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=http://localhost:8000/auth/callback

# Twitch API Configuration (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# tcomm.hivie.tn API Configuration (request from tcomm admins)
TCOMM_API_KEY=

# o!TR API Configuration (https://otr.stagec.net)
OTR_API_KEY=

# Master User Configuration (osu! user ID with master privileges)
MASTER_OSU_ID=

# Database Backup Configuration (R2 storage)
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=7
BACKUP_VERIFY_UPLOAD=true
BACKUP_DISCORD_WEBHOOK=

# Central Discord Server Webhooks (optional for local dev)
DISCORD_OSU_BADGE_WEBHOOK=
DISCORD_OSU_NONBADGE_WEBHOOK=
DISCORD_TAIKO_BADGE_WEBHOOK=
DISCORD_TAIKO_NONBADGE_WEBHOOK=
DISCORD_CATCH_BADGE_WEBHOOK=
DISCORD_CATCH_NONBADGE_WEBHOOK=
DISCORD_MANIA_BADGE_WEBHOOK=
DISCORD_MANIA_NONBADGE_WEBHOOK=

# osu! Score Integration Platform (SIP) Configuration
SIP_API_KEY=
