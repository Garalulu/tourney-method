{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "garalulu/tourney-method",
    "type": "project",
    "description": "An open-source osu! tournament discovery, history, and community contribution platform.",
    "keywords": ["osu", "tournament", "laravel", "livewire"],
    "homepage": "https://github.com/Garalulu/tourney-method",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "ext-pcntl": "*",
        "ext-pgsql": "*",
        "ext-redis": "*",
        "codeat3/blade-simple-icons": "^8.12",
        "intervention/image": "^3.11",
        "jfcherng/php-diff": "^6.0",
        "laravel/framework": "^12.62",
        "laravel/horizon": "^5.42",
        "laravel/socialite": "^5.24",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.32",
        "livewire/livewire": "^3.7",
        "mallardduck/blade-lucide-icons": "^1.26",
        "punic/punic": "^3.8",
        "symfony/clock": "^8.0",
        "symfony/css-selector": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/string": "^8.0",
        "symfony/translation": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "4.4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpro/grumphp": "*",
        "phpstan/phpstan": "2.1.45",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "pint": "./vendor/bin/pint",
        "pint:test": "./vendor/bin/pint --test",
        "pint:dirty": "./vendor/bin/pint --dirty",
        "phpstan": "./vendor/bin/phpstan analyse",
        "phpstan:baseline": "./vendor/bin/phpstan analyse --generate-baseline",
        "check": [
            "@pint:test",
            "@phpstan"
        ],
        "fix": "@pint",
        "test": [
            "@test-unit",
            "@test-feature",
            "@test-integration",
            "@test-livewire"
        ],
        "test-unit": "XDEBUG_MODE=off ./vendor/bin/pest --testsuite=Unit",
        "test-feature": "XDEBUG_MODE=off php scripts/run-test-partition.php Feature 0 1",
        "test-integration": "XDEBUG_MODE=off ./vendor/bin/pest --testsuite=Integration",
        "test-livewire": "XDEBUG_MODE=off ./vendor/bin/pest --testsuite=Livewire",
        "test-parallel": "XDEBUG_MODE=off ./vendor/bin/pest --parallel --processes=4",
        "test-sequential": [
            "XDEBUG_MODE=off ./vendor/bin/pest"
        ],
        "test-coverage": [
            "XDEBUG_MODE=off ./vendor/bin/pest --coverage --min=80"
        ],
        "test-single": [
            "XDEBUG_MODE=off ./vendor/bin/pest --filter="
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "process-timeout": 1800,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpro/grumphp": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
